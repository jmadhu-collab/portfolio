    <div class="skills-grid">

        <div class="skill">HTML5</div>
        <div class="skill">CSS3</div>
        <div class="skill">JavaScript</div>
        <div class="skill">Python</div>
        <div class="skill">SQL</div>
        <div class="skill">Data Analysis</div>
        <div class="skill">Git & GitHub</div>
        <div class="skill">VS Code</div>

    </div>

</section>

<!-- PROJECTS -->
<section id="projects">

    <h2>My Projects</h2>

    <div class="projects-grid">

        <div class="project">

            <h3>Smart Productivity System</h3>

            <p>
                A smart productivity website that helps
                users manage daily tasks, goals, habits,
                schedules and reminders.
            </p>

            <a href="https://github.com/" target="_blank">
                View Project →
            </a>

        </div>

        <div class="project">

            <h3>Data Analysis Project</h3>

            <p>
                A data analysis project focused on
                exploring datasets, identifying patterns
                and presenting meaningful insights.
            </p>

            <a href="https://github.com/" target="_blank">
                View Project →
            </a>

        </div>

    </div>

</section>

<!-- EDUCATION -->
<section id="education">

    <h2>Education</h2>

    <div class="education-card">

        <h3>M.Sc. Data Science</h3>

        <p>KPR College</p>

        <p>Currently Pursuing</p>

    </div>

</section>

<!-- CONTACT -->
<section id="contact">

    <div class="contact">

        <h2>Contact Me</h2>

        <p>Let's connect and work together!</p>

        <a href="mailto:your.email@gmail.com">
            Email
        </a>

        <a href="https://github.com/your-username"
           target="_blank">
            GitHub
        </a>

        <a href="https://linkedin.com/in/your-profile"
           target="_blank">
            LinkedIn
        </a>

    </div>

</section>

<footer>
    <p>© 2026 Your Name | Personal Portfolio</p>
</footer>

<script>
const menuBtn = document.getElementById("menuBtn");
const navLinks = document.getElementById("navLinks");

menuBtn.addEventListener("click", function() {
    navLinks.classList.toggle("show");
});

document.querySelectorAll("#navLinks a").forEach(link => {
    link.addEventListener("click", function() {
        navLinks.classList.remove("show");
    });
});
</script>

</body>
</html>
